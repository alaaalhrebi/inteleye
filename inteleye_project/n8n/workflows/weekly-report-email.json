    {
      "id": "fc251376-0848-4217-9b6f-ddd92cd3fd94",
      "name": "Prepare Weekly Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const client = $json;\nconst report = $('Read Saved Report').item.json;\nconst job = $('Claim Notification').item.json;\nif (Number(client.id) !== Number(report.client_id) || Number(job.client_id) !== Number(client.id) || Number(job.report_id) !== Number(report.id)) throw new Error('NOTIFICATION_SCOPE_MISMATCH');\nconst now = Date.now();\nconst trial = client.subscription_status === 'trial' && Date.parse(client.trial_ends_at || '') > now;\nconst paid = client.subscription_status === 'active' && (!client.current_period_end || Date.parse(client.current_period_end) > now);\nconst email = typeof client.email === 'string' ? client.email.trim() : '';\nif ((!trial && !paid) || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return { json: { skip: true, error_code: !trial && !paid ? 'SUBSCRIPTION_INACTIVE' : 'CLIENT_EMAIL_MISSING' } };\nconst includeUrgent = paid && ['pro', 'enterprise'].includes(client.plan);\nconst savedCases = Array.isArray(report.stats?.reputation_urgent_cases) ? report.stats.reputation_urgent_cases : [];\nconst cases = includeUrgent ? savedCases.filter(row => Number(row.client_id) === Number(client.id) && Number(row.platform_id) === Number(report.platform_id) && (row.branch_id ?? null) === (report.branch_id ?? null) && ['high', 'critical'].includes(row.severity) && (row.sentiment === 'negative' || row.is_complaint === true)) : [];\nconst clean = value => String(value || '').replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]/g, '').slice(0, 2000);\nconst details = cases.length ? '\\n\\nتعليقات مصنفة عالية الخطورة وتحتاج مراجعتك:\\n' + cases.map((row, index) => `${index + 1}. ${clean(row.feedback_text)}\\nالسبب: ${clean(row.reason)}\\nالتاريخ: ${clean(row.published_at)}\\nالرد المقترح: ${clean(row.suggested_reply)}`).join('\\n\\n') : '';\nreturn { json: { skip: false, recipient_email: email, subject: `IntelEye — تقرير الأسبوع جاهز #${report.id}`, message: `مرحبًا ${clean(client.name)}،\\n\\nتقريرك الأسبوعي للفترة ${clean(report.period_start)} إلى ${clean(report.period_end)} جاهز.${details}\\n\\nادخل الموقع لمشاهدة التقرير:\\nhttps://www.inteleye-sa.com/dashboard/reports\\n\\nهذا تحليل مساعد، ويرجى مراجعة الحالات قبل اتخاذ إجراء.`, urgent_count: cases.length } };"
      }
    },
