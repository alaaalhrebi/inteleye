        "mode": "runOnceForEachItem",
        "jsCode": "const status = Number($json.error?.httpCode ?? $json.error?.statusCode ?? $json.httpCode ?? $json.statusCode);\nconst definite = [400, 401, 403, 404, 429].includes(status);\nreturn { json: { status: definite ? 'failed' : 'unknown', error_code: definite ? `GMAIL_REJECTED_${status}` : 'GMAIL_RESULT_UNKNOWN' } };"
      }
