    {
      "parameters": {
        "jsCode": "const original = $('Prepare Instagram AI Comment').item.json;\nlet text = $json.text || $json.output?.[0]?.content?.[0]?.text || $json.message?.content || '';\ntext = String(text)\n  .replace(new RegExp('\\\\x60{3}json', 'gi'), '')\n  .replace(new RegExp('\\\\x60{3}', 'g'), '')\n  .trim();\n\nif (!text) {\n  return [{ json: { analysis_ok: false, ...original, analysis_error: 'empty_ai_response' } }];\n}\n\ntry {\n  const result = JSON.parse(text);\n  const allowedSentiments = ['positive', 'negative', 'neutral'];\n  const allowedSeverities = ['low', 'medium', 'high'];\n  const needsReply = result.needs_reply === true;\n  return [{ json: {\n    analysis_ok: true,\n    ...original,\n    sentiment: allowedSentiments.includes(result.sentiment) ? result.sentiment : 'neutral',\n    category: Array.isArray(result.category) ? result.category : [result.category || 'أخرى'],\n    severity: allowedSeverities.includes(result.severity) ? result.severity : 'low',\n    needs_reply: needsReply,\n    is_sales_opportunity: result.is_sales_opportunity === true,\n    is_complaint: result.is_complaint === true,\n    suggested_reply: needsReply ? (result.suggested_reply || null) : null,\n    reason: result.reason || null,\n    analysis_summary: result.analysis_summary || null,\n  } }];\n} catch {\n  return [{ json: { analysis_ok: false, ...original, analysis_error: 'invalid_ai_json' } }];\n}"
