    {
      "parameters": {
        "jsCode": "const post = $('Loop Instagram Posts').item.json;\nconst comments = [];\nlet scrapeError = null;\n\nconst appendComment = (comment, parentId = null) => {\n  const commentId = String(comment.id || comment.commentId || '').trim();\n  const text = String(comment.text || comment.commentText || '').trim();\n  if (!commentId || !text) return;\n\n  comments.push({\n    comment_id: commentId,\n    commenter_username: comment.ownerUsername || comment.username || comment.owner?.username || null,\n    comment_text: text,\n    comment_date: comment.timestamp || comment.createdAt || comment.created_at || null,\n    like_count: Math.max(0, Number(comment.likesCount ?? comment.likeCount ?? 0)),\n    is_reply: Boolean(parentId || comment.parentCommentUrl),\n    reply_to_comment_id: parentId,\n    is_author_reply: false,\n    raw_data: comment,\n  });\n\n  for (const reply of Array.isArray(comment.replies) ? comment.replies : []) {\n    appendComment(reply, commentId);\n  }\n};\n\nfor (const item of items) {\n  const result = item.json || {};\n  if (result.error || result.errorDescription || result.requestErrorMessages) {\n    scrapeError = String(result.errorDescription || result.error || 'تعذر جلب تعليقات الفيديو');\n    continue;\n  }\n  appendComment(result);\n}\n\nreturn [{ json: {\n  scrape_ok: !scrapeError,\n  scrape_error: scrapeError,\n  post,\n  comments,\n} }];"
