      "parameters": {
        "jsCode": "const context = $('Collect Instagram Context').item.json;\nconst platform = context.platform;\nconst knownById = new Map((context.known_posts || []).map(post => [String(post.post_id), post]));\nconst cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;\nconst posts = [];\nlet accountError = null;\n\nfor (const item of items) {\n  const media = item.json || {};\n  if (media.error || media.errorDescription || media.requestErrorMessages) {\n    accountError = String(media.errorDescription || media.error || 'تعذر جلب منشورات حساب Instagram');\n    continue;\n  }\n\n  const publishedAt = media.timestamp || media.publishedAt || media.takenAt || null;\n  const publishedTime = publishedAt ? new Date(publishedAt).getTime() : NaN;\n  const mediaType = String(media.type || media.productType || '').toLowerCase();\n  const isVideo = mediaType === 'video' || mediaType === 'clips' || mediaType === 'reel';\n  if (!isVideo || Number.isNaN(publishedTime) || publishedTime < cutoff) continue;\n\n  const postId = String(media.id || media.mediaId || media.shortCode || '').trim();\n  const postUrl = String(media.url || (media.shortCode ? 'https://www.instagram.com/reel/' + media.shortCode + '/' : '')).trim();\n  if (!postId || !postUrl) continue;\n\n  const commentCount = Math.max(0, Number(media.commentsCount ?? media.commentCount ?? 0));\n  const known = knownById.get(postId);\n  if (known && commentCount <= Number(known.last_comment_count || 0)) continue;\n\n  posts.push({\n    client_id: platform.client_id,\n    branch_id: platform.branch_id ?? null,\n    platform_id: platform.id,\n    post_id: postId,\n    post_url: postUrl,\n    media_type: media.type || media.productType || 'Video',\n    published_at: new Date(publishedTime).toISOString(),\n    comment_count: commentCount,\n    previous_comment_count: Number(known?.last_comment_count || 0),\n    settings: platform.settings || {},\n  });\n}\n\nif (!posts.length) {\n  return [{ json: {\n    has_posts: false,\n    account_error: accountError,\n    platform,\n  } }];\n}\n\nreturn posts.map(post => ({ json: { has_posts: true, ...post } }));"
