        "jsonBody": "={{ {\n  directUrls: [$json.platform.platform_url],\n  resultsType: 'posts',\n  resultsLimit: Number($json.platform.settings?.instagram_max_posts || 100),\n  onlyPostsNewerThan: '30 days',\n  addParentData: true\n} }}",
