      "parameters": {
        "jsCode": "const platform = $json;\nconst profileUrl = String(platform.platform_url || '').trim();\n\nif (!platform.id || !platform.client_id) {\n  throw new Error('سياق منصة Instagram غير مكتمل');\n}\n\nif (!/^https?:\\/\\/(www\\.)?instagram\\.com\\/[^/?#]+/i.test(profileUrl)) {\n  throw new Error('رابط حساب Instagram غير صالح');\n}\n\nreturn [{ json: {\n  ...platform,\n  platform_url: profileUrl.replace(/\\/+$|\\?.*$/g, '') + '/',\n  branch_id: platform.branch_id ?? null,\n  settings: platform.settings && typeof platform.settings === 'object' ? platform.settings : {},\n} }];"
